<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="ticketingsitedemo.server.MemberMapper">

    <!--select-->
    <select id="findAll" resultType="ticketingsitedemo.server.Member">
        SELECT * FROM member
    </select>

    <select id="findById" parameterType="long" resultType="ticketingsitedemo.server.Member">
        SELECT * FROM member WHERE id = #{id}
    </select>


    <!--insert-->
    <insert id="insert" parameterType="com.ticketingsitedemo.domain.Member" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO member(username, email, role)
        VALUES(#{username}, #{email}, #{role})
    </insert>
</mapper>
